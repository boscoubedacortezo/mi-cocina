# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=
# Legacy "anon" key or new "publishable" key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Legacy "service_role" key or new "secret" key (sb_secret_...). Server only.
SUPABASE_SERVICE_ROLE_KEY=
# https://console.anthropic.com → API Keys. Server only.
ANTHROPIC_API_KEY=
# The only email allowed to sign in
ALLOWED_EMAIL=

# https://www.pexels.com/api/ (free). Optional: enables suggested recipe photos. Server only.
PEXELS_API_KEY=
